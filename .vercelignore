# Include only application source, public assets, and build configuration.
*
!app
!app/**
!api
!api/*.py
!backend
!backend/**
!public
!public/**
!package.json
!package-lock.json
!requirements.txt
!.python-version
!next.config.ts
!next-env.d.ts
!tsconfig.json
!eslint.config.mjs
!vercel.json

# Omit generated files, tests, and local configuration from included folders.
**/node_modules
**/__pycache__
**/*.py[cod]
**/*.test.*
**/.env*
**/.DS_Store
**/*.md
